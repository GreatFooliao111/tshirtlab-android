# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Binary files - preserve exact bytes
gradle/wrapper/gradle-wrapper.jar binary
*.jar binary
*.apk binary
*.aab binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.keystore binary

# Executables & Scripts with Unix line endings
gradlew text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
